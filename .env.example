# ============================================================
# AgriOS Environment Variables — Google-First Stack
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ----------------------------------------------------------
# Firebase (Client-safe — use NEXT_PUBLIC_)
# Get from: https://console.firebase.google.com/ > Project Settings > General > Your apps
# ----------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ----------------------------------------------------------
# Google AI / Gemini (SERVER-ONLY — never NEXT_PUBLIC_)
# Get from: https://ai.google.dev/
# ----------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com
GEMINI_MODEL=gemini-3.6-flash

# ----------------------------------------------------------
# Google Maps Platform (Client-safe)
# Get from: https://console.cloud.google.com/ > APIs & Services
# Enable: Maps JavaScript API, Places API
# ----------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ----------------------------------------------------------
# Google Earth Engine (SERVER-ONLY)
# Register: https://earthengine.google.com/
# App uses demo NDVI values if not configured.
# ----------------------------------------------------------
EARTH_ENGINE_PROJECT_ID=your-gee-project-id
EARTH_ENGINE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com

# ----------------------------------------------------------
# Google Cloud (SERVER-ONLY — optional P1 features)
# ----------------------------------------------------------
GOOGLE_CLOUD_PROJECT_ID=your-project-id
BIGQUERY_DATASET=agrios_analytics

# ----------------------------------------------------------
# App Config
# ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to "true" to force demo mode without live APIs
NEXT_PUBLIC_DEMO_MODE=false
